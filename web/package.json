{
  "name": "contrast-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "bun run server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src server server.ts vite.config.ts",
    "format": "oxfmt --write src server server.ts vite.config.ts package.json tsconfig.json index.html",
    "format:check": "oxfmt --check src server server.ts vite.config.ts package.json tsconfig.json index.html"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.4",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uplot": "^1.6.32",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.2.20",
    "@types/node": "^26.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "oxfmt": "^0.17.0",
    "oxlint": "^1.17.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  }
}
